# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=ai-service-group
KAFKA_TOPIC_CONSUME=radio.uploaded
KAFKA_TOPIC_PRODUCE=ai.prediction.done

# MinIO — must match your docker-compose values
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-local-minio-password
MINIO_BUCKET_RADIO=radio-bucket
MINIO_BUCKET_HEATMAP=heatmap-bucket
MINIO_SECURE=false

# Model
MODEL_DENSENET_PATH=/app/weights/DenseNet121_final.pt
MODEL_EFFNET_PATH=/app/weights/EfficientNetB3_final.pt
DEVICE=cpu

# App
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO
